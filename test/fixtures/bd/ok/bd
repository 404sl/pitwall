#!/bin/sh
echo "warning: beads.role not configured (GH#2950)." >&2
case "$BEADS_DIR" in
  */.beads) ;;
  *) echo "Error: no beads database found under ${BEADS_DIR:-\$PWD}" >&2; exit 1 ;;
esac
out=$(dirname "$BEADS_DIR")/bd-output
if [ -n "$BD_CALL_LOG" ]; then
  printf '%s\n' "$*" >> "$BD_CALL_LOG"
fi
case "$*" in
  "statuses --json") cat "$out/statuses.json" ;;
  "list --all --limit 0 --json") cat "$out/${BD_LIST_FIXTURE:-all}.json" ;;
  "blocked --json") cat "$out/blocked.json" ;;
  "show --id "*" --json --include-dependents")
    if [ -f "$out/show-$3.json" ]; then
      cat "$out/show-$3.json"
    else
      echo "Error fetching $3: no issue found matching \"$3\"" >&2
      printf '{\n  "error": "no issues found matching the provided IDs",\n  "schema_version": 1\n}\n'
      exit 1
    fi
    ;;
  "create "*)
    if [ -n "$BD_CREATE_FAIL" ]; then
      echo "Error: $BD_CREATE_FAIL" >&2
      exit 1
    fi
    body=""
    meta=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --body-file) body="$2"; shift ;;
        --metadata) meta="${2#@}"; shift ;;
      esac
      shift
    done
    if [ -n "$BD_BODY_LOG" ] && [ -n "$body" ]; then cp "$body" "$BD_BODY_LOG"; fi
    if [ -n "$BD_CREATE_META_LOG" ] && [ -n "$meta" ]; then cp "$meta" "$BD_CREATE_META_LOG"; fi
    printf '%s\n' "${BD_CREATE_ID:-mw-new}"
    ;;
  "update "*" --metadata @"*)
    if [ -n "$BD_METADATA_FAIL" ]; then
      echo "Error: $BD_METADATA_FAIL" >&2
      exit 1
    fi
    if [ -n "$BD_META_LOG" ]; then cp "${4#@}" "$BD_META_LOG"; fi
    echo "✓ Updated issue: $2"
    ;;
  "update "*" --append-notes "*)
    if [ -z "$BD_NOTES_LOG" ]; then
      echo "Error: nowhere to record notes" >&2
      exit 1
    fi
    printf '%s\n' "$2 $4" >> "$BD_NOTES_LOG"
    echo "✓ Updated issue: $2"
    ;;
  "update "*" --remove-label "*)
    if [ -n "$BD_LABELS_FAIL" ]; then
      echo "Error: $BD_LABELS_FAIL" >&2
      exit 1
    fi
    echo "✓ Updated issue: $2"
    ;;
  *) echo "Error: unknown command: bd $*" >&2; exit 2 ;;
esac
